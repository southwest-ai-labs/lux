#!/usr/bin/env bash
# luxctl — CLI for Lux monitor control (DDC/CI via ddcutil).
# Works headless: agents and scripts can use this even when the Flutter app
# (and its HTTP API) is closed. Same VCP codes as lib/src/ddc_service.dart.
set -euo pipefail

VCP_BRIGHTNESS=10   # 0x10, generic on every MCCS monitor
VCP_CONTRAST=12     # 0x12
PRESET_NIGHT=15
PRESET_READING=35
PRESET_DAY=80

die() { echo "luxctl: $*" >&2; exit 1; }
need_ddc() { command -v ddcutil >/dev/null || die "ddcutil not in PATH (NixOS: pkgs.ddcutil)."; }

check_i2c_hint() {
  if ! ls /dev/i2c-* >/dev/null 2>&1; then
    echo "hint: no /dev/i2c-* devices. NixOS: hardware.i2c.enable = true + user in group i2c, rebuild, relogin." >&2
  fi
}

cmd_doctor() {
  echo "== luxctl doctor =="
  command -v ddcutil >/dev/null && echo "ddcutil: $(ddcutil --version 2>/dev/null | head -n1)" || echo "ddcutil: MISSING"
  if ls /dev/i2c-* >/dev/null 2>&1; then echo "i2c-dev: OK ($(ls /dev/i2c-* 2>/dev/null | tr '\n' ' '))"; else echo "i2c-dev: MISSING (modprobe i2c-dev / hardware.i2c.enable)"; fi
  if [ -r /dev/i2c-0 ] 2>/dev/null || groups | grep -qw i2c || [ "$(id -u)" = 0 ]; then echo "permissions: likely OK"; else echo "permissions: user NOT in i2c group (run: groups)"; fi
  need_ddc; check_i2c_hint
  ddcutil detect --brief 2>&1 | head -n 20 || true
}

cmd_detect() {
  need_ddc; check_i2c_hint
  if [ "${1:-}" = "--json" ]; then
    echo '{"monitors":['
    first=1
    while IFS= read -r line; do
      case "$line" in
        Display*) id=$(echo "$line" | grep -o '[0-9]*'); [ $first = 0 ] && echo ','; first=0; printf '{"id":%s' "$id" ;;
        *I2C\ bus:*) printf ',"i2c_bus":"%s"' "$(echo "$line" | awk -F: '{print $NF}' | xargs)" ;;
        *DRM\ connector:*) printf ',"drm":"%s"' "$(echo "$line" | awk '{print $NF}')" ;;
        *Monitor:*|*Model:*) printf ',"model":"%s"}' "$(echo "$line" | cut -d: -f2- | xargs | cut -c1-60)" ;;
      esac
    done < <(ddcutil detect --brief 2>/dev/null || true)
    echo ']}'
  else
    ddcutil detect --brief 2>&1 || { check_i2c_hint; exit 1; }
  fi
}

resolve_vcp() {
  case "${1,,}" in
    brightness|10|0x10) echo "$VCP_BRIGHTNESS" ;;
    contrast|12|0x12) echo "$VCP_CONTRAST" ;;
    *) die "unknown feature '$1' (use brightness|contrast)" ;;
  esac
}

cmd_get() { # get <display> [brightness|contrast]
  need_ddc
  id="${1:?usage: luxctl get <display> [brightness|contrast]}"
  feat=$(resolve_vcp "${2:-brightness}")
  ddcutil --brief --display "$id" getvcp "$feat" 2>&1 || { check_i2c_hint; exit 1; }
}

cmd_set() { # set <display> <brightness|contrast> <0-100>
  need_ddc
  id="${1:?usage: luxctl set <display> <brightness|contrast> <0-100>}"
  feat=$(resolve_vcp "${2:?missing feature}")
  val="${3:?missing value}"
  [[ "$val" =~ ^[0-9]+$ ]] && [ "$val" -ge 0 ] && [ "$val" -le 100 ] || die "value must be 0-100"
  ddcutil --display "$id" setvcp "$feat" "$val" 2>&1 || { check_i2c_hint; exit 1; }
  echo "display $id: feature $feat -> $val"
}

cmd_preset() { # preset <night|reading|day> [display]
  need_ddc
  case "${1:?usage: luxctl preset <night|reading|day> [display]}" in
    night) v=$PRESET_NIGHT ;; reading) v=$PRESET_READING ;; day) v=$PRESET_DAY ;;
    *) die "unknown preset '$1'" ;;
  esac
  if [ -n "${2:-}" ]; then
    ddcutil --display "$2" setvcp $VCP_BRIGHTNESS "$v" && echo "display $2 -> $v"
  else
    ids=$(ddcutil detect --brief 2>/dev/null | grep -o '^Display [0-9]*' | grep -o '[0-9]*' || true)
    [ -z "$ids" ] && { check_i2c_hint; die "no displays found"; }
    for id in $ids; do ddcutil --display "$id" setvcp $VCP_BRIGHTNESS "$v" && echo "display $id -> $v" || echo "display $id FAILED" >&2; done
  fi
}

cmd_token() {
  f="${XDG_CONFIG_HOME:-$HOME/.config}/lux/token"
  [ -f "$f" ] && { echo "token file: $f"; [ "${1:-}" = "--show" ] && cat "$f"; } || echo "no token yet (start the Lux app once)"
}

# shellcheck disable=SC2086
_lux_temp_set() { # _lux_temp_set <kelvin> — hold temp via wlsunset, save prev
  k="$1"
  command -v wlsunset >/dev/null || { echo "temperature: skipped (wlsunset missing)" >&2; return 0; }
  state="${XDG_CONFIG_HOME:-$HOME/.config}/lux/wlsunset.prev"
  mkdir -p "${state%/*}"
  if [ ! -f "$state" ]; then
    prev=$(pgrep -a -x wlsunset 2>/dev/null | head -n1 | awk '{$1=$2=""; print $0}' | xargs || true)
    [ -n "$prev" ] && printf '%s' "$prev" > "$state" || true
  fi
  pkill -x wlsunset 2>/dev/null || true
  # wlsunset needs high>low (strict): pin low=K-1, high=K (±1K invisible)
  nohup wlsunset -t "$((k-1))" -T "$k" >/dev/null 2>&1 &
  disown 2>/dev/null || true
  echo "temperature -> ${k}K (wlsunset pid $!)"
}

_lux_temp_restore() {
  pkill -x wlsunset 2>/dev/null || true
  state="${XDG_CONFIG_HOME:-$HOME/.config}/lux/wlsunset.prev"
  if [ -f "$state" ]; then
    # shellcheck disable=SC2086
    nohup wlsunset $(cat "$state") >/dev/null 2>&1 &
    disown 2>/dev/null || true
    rm -f "$state"
    echo "color restored (previous night-light relaunched)"
  else
    echo "color cleared (nothing to restore)"
  fi
}

cmd_profile() { # profile <gaming|code|video|read> — brightness (ddcutil) + temp (wlsunset)
  case "${1:?usage: luxctl profile <gaming|code|video|read>}" in
    gaming|jugar) v=90; t=6500 ;; code|programar) v=65; t=5500 ;;
    video|cine) v=45; t=4500 ;; read|leer) v=35; t=4000 ;;
    *) die "unknown profile '$1' (gaming|code|video|read)" ;;
  esac
  need_ddc
  ids=$(ddcutil detect --brief 2>/dev/null | grep -o '^Display [0-9]*' | grep -o '[0-9]*' || true)
  if [ -z "$ids" ]; then echo "brightness: skipped (no DDC/CI monitors)" >&2;
  else for id in $ids; do ddcutil --display "$id" setvcp $VCP_BRIGHTNESS "$v" >/dev/null 2>&1 && echo "display $id brightness -> $v" || echo "display $id brightness FAILED" >&2; done; fi
  _lux_temp_set "$t"
}

cmd_temp() { # temp <1000-10000|off>
  case "${1:?usage: luxctl temp <1000-10000|off>}" in
    off) _lux_temp_restore ;;
    *) [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1000 ] && [ "$1" -le 10000 ] || die "kelvin must be 1000-10000 or 'off'"; _lux_temp_set "$1" ;;
  esac
}

usage() {
  cat <<'EOF'
luxctl — DDC/CI monitor control (works without the Lux GUI running)
  luxctl doctor                        checks: ddcutil, i2c-dev, perms, detect
  luxctl detect [--json]               list DDC/CI monitors
  luxctl get <display> [feat]          read level (feat: brightness|contrast)
  luxctl set <display> <feat> <0-100>  set level
  luxctl preset <night|reading|day> [display]
  luxctl profile <gaming|code|video|read>   brightness+temp (best-effort each)
  luxctl temp <1000-10000|off>              hold color temp / restore previous
  luxctl token [--show]                show API token file
VCP: brightness=0x10 contrast=0x12 (VESA MCCS, generic for all brands).
EOF
}

case "${1:-}" in
  doctor) shift; cmd_doctor "$@" ;; detect) shift; cmd_detect "$@" ;;
  get) shift; cmd_get "$@" ;; set) shift; cmd_set "$@" ;;
  preset) shift; cmd_preset "$@" ;; token) shift; cmd_token "$@" ;;
  profile) shift; cmd_profile "$@" ;; temp) shift; cmd_temp "$@" ;;
  *) usage ;;
esac
