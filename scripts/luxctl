#!/usr/bin/env bash
# luxctl — CLI for Lux monitor control (DDC/CI via ddcutil).
# Works headless: agents and scripts can use this even when the Flutter app
# (and its HTTP API) is closed. Same VCP codes as lib/src/ddc_service.dart.
set -euo pipefail

VCP_BRIGHTNESS=10   # 0x10, generic on every MCCS monitor
VCP_CONTRAST=12     # 0x12
PRESET_NIGHT=15
PRESET_READING=35
PRESET_DAY=80

die() { echo "luxctl: $*" >&2; exit 1; }
need_ddc() { command -v ddcutil >/dev/null || die "ddcutil not in PATH (NixOS: pkgs.ddcutil)."; }

check_i2c_hint() {
  if ! ls /dev/i2c-* >/dev/null 2>&1; then
    echo "hint: no /dev/i2c-* devices. NixOS: hardware.i2c.enable = true + user in group i2c, rebuild, relogin." >&2
  fi
}

cmd_doctor() {
  echo "== luxctl doctor =="
  command -v ddcutil >/dev/null && echo "ddcutil: $(ddcutil --version 2>/dev/null | head -n1)" || echo "ddcutil: MISSING"
  if ls /dev/i2c-* >/dev/null 2>&1; then echo "i2c-dev: OK ($(ls /dev/i2c-* 2>/dev/null | tr '\n' ' '))"; else echo "i2c-dev: MISSING (modprobe i2c-dev / hardware.i2c.enable)"; fi
  if [ -r /dev/i2c-0 ] 2>/dev/null || groups | grep -qw i2c || [ "$(id -u)" = 0 ]; then echo "permissions: likely OK"; else echo "permissions: user NOT in i2c group (run: groups)"; fi
  need_ddc; check_i2c_hint
  ddcutil detect --brief 2>&1 | head -n 20 || true
}

cmd_detect() {
  need_ddc; check_i2c_hint
  if [ "${1:-}" = "--json" ]; then
    echo '{"monitors":['
    first=1
    while IFS= read -r line; do
      case "$line" in
        Display*) id=$(echo "$line" | grep -o '[0-9]*'); [ $first = 0 ] && echo ','; first=0; printf '{"id":%s' "$id" ;;
        *I2C\ bus:*) printf ',"i2c_bus":"%s"' "$(echo "$line" | awk -F: '{print $NF}' | xargs)" ;;
        *DRM\ connector:*) printf ',"drm":"%s"' "$(echo "$line" | awk '{print $NF}')" ;;
        *Monitor:*|*Model:*) printf ',"model":"%s"}' "$(echo "$line" | cut -d: -f2- | xargs | cut -c1-60)" ;;
      esac
    done < <(ddcutil detect --brief 2>/dev/null || true)
    echo ']}'
  else
    ddcutil detect --brief 2>&1 || { check_i2c_hint; exit 1; }
  fi
}

resolve_vcp() {
  case "${1,,}" in
    brightness|10|0x10) echo "$VCP_BRIGHTNESS" ;;
    contrast|12|0x12) echo "$VCP_CONTRAST" ;;
    *) die "unknown feature '$1' (use brightness|contrast)" ;;
  esac
}

cmd_get() { # get <display> [brightness|contrast]
  need_ddc
  id="${1:?usage: luxctl get <display> [brightness|contrast]}"
  feat=$(resolve_vcp "${2:-brightness}")
  ddcutil --brief --display "$id" getvcp "$feat" 2>&1 || { check_i2c_hint; exit 1; }
}

cmd_set() { # set <display> <brightness|contrast> <0-100>
  need_ddc
  id="${1:?usage: luxctl set <display> <brightness|contrast> <0-100>}"
  feat=$(resolve_vcp "${2:?missing feature}")
  val="${3:?missing value}"
  [[ "$val" =~ ^[0-9]+$ ]] && [ "$val" -ge 0 ] && [ "$val" -le 100 ] || die "value must be 0-100"
  ddcutil --display "$id" setvcp "$feat" "$val" 2>&1 || { check_i2c_hint; exit 1; }
  echo "display $id: feature $feat -> $val"
}

cmd_preset() { # preset <night|reading|day> [display]
  need_ddc
  case "${1:?usage: luxctl preset <night|reading|day> [display]}" in
    night) v=$PRESET_NIGHT ;; reading) v=$PRESET_READING ;; day) v=$PRESET_DAY ;;
    *) die "unknown preset '$1'" ;;
  esac
  if [ -n "${2:-}" ]; then
    ddcutil --display "$2" setvcp $VCP_BRIGHTNESS "$v" && echo "display $2 -> $v"
  else
    ids=$(ddcutil detect --brief 2>/dev/null | grep -o '^Display [0-9]*' | grep -o '[0-9]*' || true)
    [ -z "$ids" ] && { check_i2c_hint; die "no displays found"; }
    for id in $ids; do ddcutil --display "$id" setvcp $VCP_BRIGHTNESS "$v" && echo "display $id -> $v" || echo "display $id FAILED" >&2; done
  fi
}

cmd_tone() { # tone <srgb|frio75|frio93> [display] — HW preset, allowlist only
  case "${1:?usage: luxctl tone <srgb|frio75|frio93> [display]}" in
    srgb|6500) v=5 ;; frio75|7500) v=6 ;; frio93|9300) v=8 ;;
    *) die "unknown tone '$1' (srgb|frio75|frio93)" ;;
  esac
  need_ddc
  if [ -n "${2:-}" ]; then
    ddcutil --display "$2" setvcp 14 "$v" && echo "display $2 tone -> $v"
  else
    ids=$(ddcutil detect --brief 2>/dev/null | grep -o '^Display [0-9]*' | grep -o '[0-9]*' || true)
    [ -z "$ids" ] && { check_i2c_hint; die "no displays found"; }
    for id in $ids; do ddcutil --display "$id" setvcp 14 "$v" && echo "display $id tone -> $v" || echo "display $id FAILED" >&2; done
  fi
}

cmd_gains() { # gains <display> [r g b] — read, or set via User1 preset
  need_ddc
  id="${1:?usage: luxctl gains <display> [r g b]}"
  if [ $# -eq 1 ]; then
    for f in 16 18 1A; do ddcutil --brief --display "$id" getvcp "$f" 2>&1 || { check_i2c_hint; exit 1; }; done
  else
    [ $# -eq 4 ] || die "usage: luxctl gains <display> <r 0-100> <g> <b>"
    for val in "$2" "$3" "$4"; do [[ "$val" =~ ^[0-9]+$ ]] && [ "$val" -ge 0 ] && [ "$val" -le 100 ] || die "gains must be 0-100"; done
    ddcutil --display "$id" setvcp 14 11 && ddcutil --display "$id" setvcp 16 "$2" && ddcutil --display "$id" setvcp 18 "$3" && ddcutil --display "$id" setvcp 1A "$4" && echo "display $id gains -> $2/$3/$4 (User1)" || { check_i2c_hint; exit 1; }
  fi
}

# shellcheck disable=SC2086
_lux_temp_set() { # _lux_temp_set <profile> — color via hyprshade shader
  p="$1"
  command -v hyprshade >/dev/null || { echo "color: skipped (hyprshade missing)" >&2; return 0; }
  hyprshade on "lux-$p" >/dev/null 2>&1 && echo "color -> lux-$p (hyprshade)" || { echo "color FAILED (hyprshade on lux-$p)" >&2; return 1; }
}

_lux_temp_restore() {
  command -v hyprshade >/dev/null && hyprshade off >/dev/null 2>&1 && echo "color restored (shader off)" || echo "color cleared"
}

cmd_profile() { # profile <gaming|code|video|read> — brightness (ddcutil) + color (hyprshade)
  case "${1:?usage: luxctl profile <gaming|code|video|read>}" in
    gaming|jugar) v=90; p=gaming ;; code|programar) v=65; p=code ;;
    video|cine) v=45; p=video ;; read|leer) v=35; p=read ;;
    *) die "unknown profile '$1' (gaming|code|video|read)" ;;
  esac
  need_ddc
  ids=$(ddcutil detect --brief 2>/dev/null | grep -o '^Display [0-9]*' | grep -o '[0-9]*' || true)
  if [ -z "$ids" ]; then echo "brightness: skipped (no DDC/CI monitors)" >&2;
  else for id in $ids; do ddcutil --display "$id" setvcp $VCP_BRIGHTNESS "$v" >/dev/null 2>&1 && echo "display $id brightness -> $v" || echo "display $id brightness FAILED" >&2; done; fi
  _lux_temp_set "$p"
}

cmd_temp() { # temp <1000-10000|off> — nearest lux shader; >=6000 = off
  case "${1:?usage: luxctl temp <1000-10000|off>}" in
    off) _lux_temp_restore ;;
    *) [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1000 ] && [ "$1" -le 10000 ] || die "kelvin must be 1000-10000 or 'off'"
       k="$1"
       if [ "$k" -ge 6000 ]; then _lux_temp_restore;
       elif [ "$k" -ge 5000 ]; then _lux_temp_set code;
       elif [ "$k" -ge 4250 ]; then _lux_temp_set video;
       else _lux_temp_set read; fi ;;
  esac
}

cmd_input() { # input <dp|hdmi> [display] — allowlist from capabilities
  case "${1:?usage: luxctl input <dp|hdmi> [display]}" in
    dp) v=15 ;; hdmi) v=17 ;;
    *) die "unknown input '$1' (dp|hdmi)" ;;
  esac
  need_ddc
  if [ -n "${2:-}" ]; then
    ddcutil --display "$2" setvcp 60 "$v" && echo "display $2 input -> $v"
  else
    ids=$(ddcutil detect --brief 2>/dev/null | grep -o '^Display [0-9]*' | grep -o '[0-9]*' || true)
    [ -z "$ids" ] && { check_i2c_hint; die "no displays found"; }
    for id in $ids; do ddcutil --display "$id" setvcp 60 "$v" && echo "display $id input -> $v" || echo "display $id FAILED" >&2; done
  fi
}

cmd_volume() { # volume <display> [0-100]
  need_ddc
  id="${1:?usage: luxctl volume <display> [0-100]}"
  if [ -z "${2:-}" ]; then
    ddcutil --brief --display "$id" getvcp 62 2>&1 || { check_i2c_hint; exit 1; }
  else
    [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 0 ] && [ "$2" -le 100 ] || die "volume must be 0-100"
    ddcutil --display "$id" setvcp 62 "$2" && echo "display $id volume -> $2"
  fi
}

cmd_power() { # power <display> <on|off> — DDC 0xD6 (1/4 only, wake verified)
  need_ddc
  id="${1:?usage: luxctl power <display> <on|off>}"
  case "${2:?usage: luxctl power <display> <on|off>}" in
    on) v=1 ;; off) v=4 ;;
    *) die "use on|off (standby/suspend not exposed: wake untested)" ;;
  esac
  ddcutil --display "$id" setvcp D6 "$v" && echo "display $id power -> $v"
}

cmd_refresh() { # refresh <60|120|144|200> — GPU mode via hyprctl (Hyprland)
  case "${1:?usage: luxctl refresh <60|120|144|200>}" in
    60|120|144|200) r="$1" ;;
    *) die "rate must be one of 60|120|144|200" ;;
  esac
  command -v hyprctl >/dev/null || die "hyprctl not found (Hyprland only)"
  out=$(hyprctl monitors 2>/dev/null | grep -m1 -oP '^Monitor \K\S+' || true)
  [ -z "$out" ] && die "no Hyprland monitor found"
  # NOTE: keyword replaces the whole monitor line: keep res+pos+scale.
  hyprctl keyword monitor "$out,1920x1080@${r},0x0,1" >/dev/null && echo "$out -> ${r}Hz (flicker normal)" || die "hyprctl rejected the mode"
  sleep 1
  hyprctl monitors 2>/dev/null | grep -m1 -o '[0-9]*x[0-9]*@[0-9.]*' || true
}

cmd_dpms() { # dpms <off|on> [output] — compositor sleep (any key wakes)
  case "${1:?usage: luxctl dpms <off|on> [output]}" in
    off|on) st="$1" ;;
    *) die "use off|on" ;;
  esac
  command -v hyprctl >/dev/null || die "hyprctl not found (Hyprland only)"
  hyprctl dispatch dpms "$st" ${2:-} >/dev/null && echo "dpms $st ${2:-(all)}"
}

cmd_auto() { # auto — circadian profile from current hour (no daemon)
  h=$(date +%H | sed 's/^0*//'); [ -z "$h" ] && h=0
  # Daylight hours: brightness up, color neutral (shader off).
  if [ "$h" -ge 9 ] && [ "$h" -lt 18 ]; then
    need_ddc
    ids=$(ddcutil detect --brief 2>/dev/null | grep -o '^Display [0-9]*' | grep -o '[0-9]*' || true)
    for id in $ids; do ddcutil --display "$id" setvcp $VCP_BRIGHTNESS 85 >/dev/null 2>&1 && echo "display $id brightness -> 85"; done
    command -v hyprshade >/dev/null && hyprshade off >/dev/null 2>&1 && echo "color -> neutral (shader off)"
    echo "auto: hour $h -> daylight"
    return 0
  fi
  if [ "$h" -ge 22 ] || [ "$h" -lt 6 ]; then p=read;
  elif [ "$h" -lt 9 ]; then p=code;
  else p=video; fi
  cmd_profile "$p"
  echo "auto: hour $h -> $p"
}

usage() {
  cat <<'EOF'
luxctl — DDC/CI monitor control (works without the Lux GUI running)
  luxctl doctor                        checks: ddcutil, i2c-dev, perms, detect
  luxctl detect [--json]               list DDC/CI monitors
  luxctl get <display> [feat]          read level (feat: brightness|contrast)
  luxctl set <display> <feat> <0-100>  set level
  luxctl preset <night|reading|day> [display]
  luxctl profile <gaming|code|video|read>   brightness+temp (best-effort each)
  luxctl temp <1000-10000|off>              hold color temp / restore previous
  luxctl tone <srgb|frio75|frio93> [display] HW color preset 6500/7500/9300K
  luxctl gains <display> [r g b]            read RGB gains / set via User1
  luxctl input <dp|hdmi> [display]          switch input (allowlist only)
  luxctl volume <display> [0-100]           read / set speaker volume
  luxctl power <display> <on|off>           DDC power (off wakes back on)
  luxctl refresh <60|120|144|200>           GPU refresh rate (hyprctl)
  luxctl dpms <off|on> [output]             panel sleep (Hyprland DPMS)
  luxctl auto                               circadian profile from hour
VCP: brightness=0x10 contrast=0x12 (VESA MCCS, generic for all brands).
EOF
}

case "${1:-}" in
  doctor) shift; cmd_doctor "$@" ;; detect) shift; cmd_detect "$@" ;;
  get) shift; cmd_get "$@" ;; set) shift; cmd_set "$@" ;;
  preset) shift; cmd_preset "$@" ;;
  profile) shift; cmd_profile "$@" ;; temp) shift; cmd_temp "$@" ;;
  tone) shift; cmd_tone "$@" ;; gains) shift; cmd_gains "$@" ;;
  input) shift; cmd_input "$@" ;; volume) shift; cmd_volume "$@" ;;
  power) shift; cmd_power "$@" ;; refresh) shift; cmd_refresh "$@" ;;
  dpms) shift; cmd_dpms "$@" ;; auto) shift; cmd_auto "$@" ;;
  *) usage ;;
esac
